# Copy to .env (or .env.local) and fill in. Expo inlines EXPO_PUBLIC_* at build time: restart Metro after a change.
# Never put secrets here: every EXPO_PUBLIC_* value ships inside the app bundle.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# REQUIRED. Base URL of the Gonarra API, without the trailing /v1 (e.g. http://192.168.1.20:8000 for a dev machine on
# the LAN; a phone cannot reach "localhost" on your computer). The app has no demo/offline data: when this is empty or
# not an http(s) URL, it shows a "not configured" screen instead of the app.
EXPO_PUBLIC_API_URL=

# Optional. ImageKit public URL endpoint for photos stored in the S3 media bucket, e.g. https://ik.imagekit.io/<your_id>
# (ADR-002). Public value only; never put an ImageKit private key in the app. Absolute https image URLs from the API
# (e.g. Wikimedia Commons) are shown directly either way; empty = relative media paths show the category illustration.
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Optional feature flags (1 = on).
EXPO_PUBLIC_FEATURE_REGENERATION=0
EXPO_PUBLIC_FEATURE_PRICES=0
EXPO_PUBLIC_FEATURE_VOICE=0
