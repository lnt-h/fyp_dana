EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# 1 = use bundled fixture data (src/lib/api/fixtures) instead of the API, which is not wired yet (TASK-001).
EXPO_PUBLIC_USE_FIXTURES=1
# ImageKit public URL endpoint for photo delivery, e.g. https://ik.imagekit.io/<your_id> (origin: the S3 media bucket, ADR-002).
# Public value only; never put an ImageKit private key in the app. Empty = use bundled fixture photos.
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=
# Dev only: make the saved Hội An fixture trip start today to show the Home "Today" card.
EXPO_PUBLIC_FIXTURE_TRIP_TODAY=0
