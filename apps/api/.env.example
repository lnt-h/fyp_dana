# Gonarra API settings (app/config.py). Copy to apps/api/.env; never commit real secrets.
# Every variable is optional; the value shown is the default unless marked otherwise.

# Display name used as the OpenAPI title.
GONARRA_APP_NAME="Gonarra API"
# One of: development, test, demo, staging, production (production disables /docs; demo = owner
# demo without Google Maps, may use GONARRA_ROUTES_ESTIMATE_ENABLED).
GONARRA_ENVIRONMENT=development
# SQLAlchemy URL for PostgreSQL 16 + PostGIS + pgvector (local docker compose default).
GONARRA_DATABASE_URL=postgresql+psycopg://gonarra:gonarra@localhost:5432/gonarra

# Clerk issuer URL (placeholder; the JWKS URL is derived from it unless set below).
GONARRA_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Explicit Clerk JWKS URL; overrides the issuer-derived one (must be a URL, so leave commented if unused).
# GONARRA_CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Expected JWT audience, if Clerk tokens carry one.
GONARRA_CLERK_AUDIENCE=
# Comma-separated allowed `azp` origins for Clerk tokens. Enforced only for tokens that carry
# `azp` (browser origins); native app session tokens (Expo / React Native) have no `azp` and are
# not checked against this list (mirrors Clerk's backend SDKs).
GONARRA_CLERK_AUTHORIZED_PARTIES=gonarra://,http://localhost:8081
# Comma-separated Clerk user IDs (JWT `sub`, e.g. user_2abc...) with the curator role on /v1/admin.
# Empty = no curators (default deny).
GONARRA_CURATOR_CLERK_USER_IDS=
# Clerk Backend API secret key (sk_...); used only to delete the Clerk user after an account
# deletion purge. Blank = not configured (the purge completes and logs a warning).
GONARRA_CLERK_SECRET_KEY=
# Owner demo builds ONLY: 1 = a request with no Authorization header uses one shared account
# (`demo_shared_user`) instead of 401, so the app works without signing in. A sent bearer token
# is still verified; never grants the curator role. Refused unless GONARRA_ENVIRONMENT is
# development, test or demo. Everyone on the demo shares (and can delete) the same trips.
GONARRA_DEMO_SHARED_USER=0

# Enabled city for the FYP release (DEC-013).
GONARRA_DEFAULT_CITY_CODE=da-nang

# Provider secrets (ADR-006, BR-046): server-side only, never logged or sent to clients.
# Google Gemini API key (selector, grounded writer).
GONARRA_GEMINI_API_KEY=
# Groq API key (fallback chain, researcher).
GONARRA_GROQ_API_KEY=
# Tavily search API key (research agent).
GONARRA_TAVILY_API_KEY=
# Google Maps Platform key (Routes, Places). SKU protection: Routes calls use TRAFFIC_UNAWARE;
# Places field mask stays id,businessStatus,location.
GONARRA_GOOGLE_MAPS_API_KEY=

# Research agent in propose_trip on/off (ADR-014). Off by default; runs only for a thin catalog
# pool, bounded by GONARRA_RESEARCH_TIMEOUT_S. (Old name GONARRA_RESEARCH_AGENT_ENABLED still read.)
GONARRA_RESEARCH_ENABLED=false
GONARRA_RESEARCH_TIMEOUT_S=45
# Indicative stay prices via LiteAPI, Could scope (DEC-019).
GONARRA_STAY_PRICES_ENABLED=false
# Haversine distance/duration estimates when GONARRA_GOOGLE_MAPS_API_KEY is blank. Allowed only with
# GONARRA_ENVIRONMENT=development|test|demo (refused in staging/production), never cached; legs are
# returned with estimated=true and a LEG_ESTIMATED (INFO) notice.
GONARRA_ROUTES_ESTIMATE_ENABLED=false
# Routes provider: auto (Google if key, else estimate if enabled above, else none) | google |
# estimate (forces estimates even with a Google key; refused in staging/production) | none.
# Owner demo without verified Maps billing: GONARRA_ENVIRONMENT=demo GONARRA_ROUTES_PROVIDER=estimate
GONARRA_ROUTES_PROVIDER=auto

# Free-tier quota caps (DEC-018); per calendar day UTC+7 unless noted. Exceeding a cap degrades.
# Trip proposals per account per day.
GONARRA_QUOTA_ACCOUNT_PROPOSALS_PER_DAY=10
# Guide questions per account per day.
GONARRA_QUOTA_ACCOUNT_QUESTIONS_PER_DAY=40
# Global Gemini Flash calls per day.
GONARRA_QUOTA_GEMINI_FLASH_PER_DAY=200
# Global Gemini Flash-Lite calls per day.
GONARRA_QUOTA_GEMINI_FLASH_LITE_PER_DAY=600
# Global Gemini embedding calls per day (query + corpus embeddings).
GONARRA_QUOTA_GEMINI_EMBED_PER_DAY=1000
# Global Groq calls per day.
GONARRA_QUOTA_GROQ_PER_DAY=800
# Global Tavily searches per day.
GONARRA_QUOTA_TAVILY_PER_DAY=25
# Global Tavily searches per calendar month.
GONARRA_QUOTA_TAVILY_PER_MONTH=700
# Global Google Places calls per day.
GONARRA_QUOTA_PLACES_PER_DAY=150
# Global Google Routes matrix elements per day. 300/day ~ 9 000/month, under the Routes
# Essentials monthly free threshold (free-tier protection).
GONARRA_QUOTA_ROUTES_ELEMENTS_PER_DAY=300
