              "type": "string"
            },
            "minItems": 1,
            "title": "Allowed Modes",
            "type": "array"
          },
          "day_end_time": {
            "anyOf": [
              {
                "examples": [
                  "08:00"
                ],
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day End Time"
          },
          "day_start_time": {
            "anyOf": [
              {
                "examples": [
                  "08:00"
                ],
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day Start Time"
          },
          "interest_category_codes": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Interest Category Codes",
            "type": "array"
          },
          "locale": {
            "enum": [
              "vi",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "pace": {
            "anyOf": [
              {
                "enum": [
                  "RELAXED",
                  "BALANCED",
                  "PACKED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pace"
          }
        },
        "required": [
          "locale",
          "interest_category_codes",
          "allowed_modes"
        ],
        "title": "PreferencesWrite",
        "type": "object"
      },
      "ServiceStatus": {
        "properties": {
          "service": {
            "default": "gonarra-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ServiceStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
