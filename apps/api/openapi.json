    "/v1/places": {
      "get": {
        "description": "Search published places by VI/EN name or reviewed alias, ignoring case and diacritics.",
        "operationId": "search_places_v1_places_get",
        "parameters": [
          {
            "description": "Enabled city; defaults to the enabled launch city (Đà Nẵng).",
            "in": "query",
            "name": "city_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Enabled city; defaults to the enabled launch city (Đà Nẵng).",
              "title": "City Id"
            }
          },
          {
            "description": "Alternative to city_id, e.g. da-nang.",
            "in": "query",
            "name": "city_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Alternative to city_id, e.g. da-nang.",
              "title": "City Code"
            }
          },
          {
            "description": "Search text; omitted lists places.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search text; omitted lists places.",
              "title": "Q"
            }
          },
          {
            "description": "Category code; case-insensitive (HERITAGE, heritage).",
            "in": "query",
            "name": "category_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category code; case-insensitive (HERITAGE, heritage).",
              "title": "Category Code"
            }
          },
          {
            "description": "Travel area, e.g. hoi-an-old-town.",
            "in": "query",
            "name": "area_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Travel area, e.g. hoi-an-old-town.",
              "title": "Area Code"
            }
          },
          {
            "description": "min_lng,min_lat,max_lng,max_lat (WGS84).",
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "min_lng,min_lat,max_lng,max_lat (WGS84).",
              "title": "Bbox"
            }
          },
          {
            "description": "lat,lng; combine with radius_m.",
            "in": "query",
            "name": "near",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "lat,lng; combine with radius_m.",
              "title": "Near"
            }
          },
          {
            "in": "query",
            "name": "radius_m",
            "required": false,
            "schema": {
              "default": 1000,
              "maximum": 50000,
              "minimum": 1,
              "title": "Radius M",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "relevance",
              "enum": [
                "relevance",
                "name"
              ],
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "description": "Opaque cursor from a previous page's next_cursor.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from a previous page's next_cursor.",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Content language; defaults to the account preference, then vi.",
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "vi",
                    "en"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Content language; defaults to the account preference, then vi.",
              "title": "Locale"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceSummaryPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Search Places",
        "tags": [
          "catalog"
        ]
      }
    },
    "/v1/places/{place_id}": {
