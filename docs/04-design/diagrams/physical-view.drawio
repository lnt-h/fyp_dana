<mxCell id="c14" value="&amp;laquo;device&amp;raquo;&lt;br&gt;&lt;b&gt;EC2 t4g.small&lt;br&gt;&lt;font style='font-size:9px'&gt;Graviton arm64 · 2 vCPU · 2 GiB · Elastic IP · IAM instance role · SSM Session Manager (no open SSH) · OS image: Amazon Linux 2023 arm64 (A-025) · 1 instance&lt;/font&gt;&lt;/b&gt;" style="shape=cube;size=12;boundedLbl=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;container=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c13"><mxGeometry x="15" y="35" width="690" height="420" as="geometry"/></mxCell>
