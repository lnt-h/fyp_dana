<mxCell id="c23" value="&amp;laquo;device&amp;raquo;&lt;br&gt;&lt;b&gt;RDS PostgreSQL 16 db.t4g.micro&lt;br&gt;&lt;font style='font-size:9px'&gt;2 vCPU · 1 GiB · Single-AZ · not publicly accessible · SG allows EC2 SG only · automated daily backups, 7-day retention (ASM-006)&lt;/font&gt;&lt;/b&gt;" style="shape=cube;size=12;boundedLbl=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#FFE6CC;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;container=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c22"><mxGeometry x="15" y="35" width="690" height="230" as="geometry"/></mxCell>
<mxCell id="c24" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;PostgreSQL 16 engine&lt;/b&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;container=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c23"><mxGeometry x="15" y="75" width="655" height="140" as="geometry"/></mxCell>
<mxCell id="c25" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;gonarra database&lt;/b&gt; — schema by Alembic (apps/api/migrations)&lt;br&gt;extensions postgis, vector, pgcrypto&lt;br&gt;manifests CMP-016" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c24"><mxGeometry x="20" y="35" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="c26" value="&amp;laquo;cloud service&amp;raquo;&lt;br&gt;&lt;b&gt;Amazon S3&lt;/b&gt; — manifests CMP-017&lt;br&gt;&lt;font style='font-size:9px'&gt;buckets: media (versioned), admin build, imports · block public access · presigned GET&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=10;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c10"><mxGeometry x="830" y="60" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="c27" value="&amp;laquo;cloud service&amp;raquo;&lt;br&gt;&lt;b&gt;Amazon ECR&lt;br&gt;&lt;font style='font-size:9px'&gt;API image repository (arm64 + amd64); lifecycle rule&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c10"><mxGeometry x="830" y="220" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="c28" value="&amp;laquo;cloud service&amp;raquo;&lt;br&gt;&lt;b&gt;AWS Systems Manager&lt;br&gt;&lt;font style='font-size:9px'&gt;Parameter Store SecureString (Clerk secret, DB URL, Gemini/Routes/Places/LiteAPI keys); Run Command; Session Manager&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c10"><mxGeometry x="830" y="340" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="c29" value="&amp;laquo;cloud service&amp;raquo;&lt;br&gt;&lt;b&gt;Amazon CloudWatch&lt;br&gt;&lt;font style='font-size:9px'&gt;container logs (awslogs driver, redacted), alarms&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c10"><mxGeometry x="830" y="480" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="c30" value="&amp;laquo;cloud service&amp;raquo;&lt;br&gt;&lt;b&gt;AWS Budgets&lt;br&gt;&lt;font style='font-size:9px'&gt;alarms at USD 20 / 50 / 100 (CON-001)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c10"><mxGeometry x="830" y="600" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;No disaster-recovery site.&lt;/b&gt; Single EC2 instance and Single-AZ RDS; recovery from RDS automated backups (RPO ≤ 24 h, RTO 4 h; ASM-006, ASM-012). Scaling: vertical only (instance class change)." style="shape=note;size=14;align=left;verticalAlign=top;spacing=6;fillColor=#F4CCCC;strokeColor=#B85450;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c10"><mxGeometry x="830" y="730" width="380" height="110" as="geometry"/></mxCell>
<mxCell id="c33" value="&amp;laquo;external system&amp;raquo;&lt;br&gt;&lt;b&gt;Clerk&lt;br&gt;&lt;font style='font-size:9px'&gt;authentication; JWKS; curator role&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c32"><mxGeometry x="20" y="50" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="c34" value="&amp;laquo;external system&amp;raquo;&lt;br&gt;&lt;b&gt;Google Gemini API&lt;br&gt;&lt;font style='font-size:9px'&gt;free tier: generation, embeddings, vision&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c32"><mxGeometry x="20" y="160" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="c35" value="&amp;laquo;external system&amp;raquo;&lt;br&gt;&lt;b&gt;Google Routes API&lt;br&gt;&lt;font style='font-size:9px'&gt;Compute Route Matrix, Compute Routes (WALK/DRIVE)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c32"><mxGeometry x="20" y="270" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="c36" value="&amp;laquo;external system&amp;raquo;&lt;br&gt;&lt;b&gt;Google Places API&lt;br&gt;&lt;font style='font-size:9px'&gt;live hours/status at runtime only&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c32"><mxGeometry x="20" y="380" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="c37" value="&amp;laquo;external system&amp;raquo;&lt;br&gt;&lt;b&gt;LiteAPI (fallback Hotelbeds)&lt;br&gt;&lt;font style='font-size:9px'&gt;indicative stay prices, runtime only, never stored&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c32"><mxGeometry x="20" y="490" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="c38" value="&amp;laquo;external system&amp;raquo;&lt;br&gt;&lt;b&gt;Booking partner sites&lt;br&gt;&lt;font style='font-size:9px'&gt;Agoda, Booking.com, Klook, 12Go — deep-link handoff&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#9673A6;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c32"><mxGeometry x="20" y="600" width="460" height="70" as="geometry"/></mxCell>
