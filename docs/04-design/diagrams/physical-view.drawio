<mxCell id="c19" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;Admin SPA static build&lt;/b&gt;&lt;br&gt;synced from S3, served by Caddy (OQ-035)&lt;br&gt;manifests CMP-002" style="shape=note;size=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c15"><mxGeometry x="15" y="175" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="c20" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;docker-compose.yml, Caddyfile&lt;/b&gt;&lt;br&gt;&amp;laquo;deployment spec&amp;raquo;; secrets read from SSM at container start" style="shape=note;size=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c15"><mxGeometry x="230" y="175" width="200" height="95" as="geometry"/></mxCell>
<mxCell id="c21" value="Jobs run one at a time; DuckDB memory limit below free memory (SAD §3.4.3)" style="text;fontSize=9;align=left;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="c15"><mxGeometry x="445" y="180" width="195" height="60" as="geometry"/></mxCell>
