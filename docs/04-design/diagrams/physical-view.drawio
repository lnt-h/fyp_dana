<mxCell id="c40" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;GitHub Actions runner&lt;br&gt;&lt;font style='font-size:9px'&gt;GitHub-hosted&lt;/font&gt;&lt;/b&gt;" style="shape=cube;size=12;boundedLbl=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#F5F5F5;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;container=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="360" height="300" as="geometry"/></mxCell>
