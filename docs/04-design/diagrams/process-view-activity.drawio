vetica;fontSize=11;" edge="1" parent="1" source="ac2-v42" target="ac2-v43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac2-e86" value="[base current and health not blocked]" style="html=1;endArrow=open;endFill=0;edgeStyle=orthogonalEdgeStyle;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="ac2-v43" target="ac2-v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac2-e87" value="[stale base, expired or blocked]" style="html=1;endArrow=open;endFill=0;edgeStyle=orthogonalEdgeStyle;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="ac2-v43" target="ac2-v45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac2-e88" value="" style="html=1;endArrow=open;endFill=0;edgeStyle=orthogonalEdgeStyle;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="ac2-v44" target="ac2-v46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac2-e89" value="" style="html=1;endArrow=open;endFill=0;edgeStyle=orthogonalEdgeStyle;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="ac2-v46" target="ac2-v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ac2-e90" value="" style="html=1;endArrow=open;endFill=0;edgeStyle=orthogonalEdgeStyle;rounded=0;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="ac2-v45" target="ac2-v37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1495.0" y="1698"/><mxPoint x="90.0" y="1698"/><mxPoint x="90.0" y="1422"/></Array></mxGeometry></mxCell><mxCell id="ac2-v91" value='&lt;b&gt;Legend&lt;/b&gt; — black dot: initial node · bullseye: activity final · circle with X: flow final · rounded box: action · diamond: decision / merge with [guard] on every outgoing edge · thick bar: fork / join · convex pentagon: send signal · concave notch: accept event · hourglass: time event · plain box: object node («datastore», «centralBuffer») · small square: pin · dashed rounded box: «iterative» expansion region or interruptible region · solid arrow: control flow · dashed arrow: object flow / signal · "↯" edge: interrupting edge · "«exception»" edge: exception handler edge. Lanes: green = Gonarra role/component (SAD §3.1.1), grey = «external» system (SAD §2.5). Locked stops keep place, day and visit duration (FR-049); day 1 is not re-planned (FR-048). Edit and regeneration produce a new unsaved preview revision (FR-050).' style="fontFamily=Helvetica;fontSize=11;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1970" width="1720" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
