e="fontFamily=Helvetica;fontSize=10;text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1532" width="1695" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram>
