# Production settings for docker-compose.prod.yml. On the VM:
#   cp infra/.env.example .env && chmod 600 .env
# ./.env (repository root, gitignored) is read by Compose for ${...} and loaded into the api and
# migrate containers. GONARRA_ENVIRONMENT is pinned to production by the compose file.
# Full GONARRA_* reference: apps/api/.env.example.

# --- Compose / infrastructure -------------------------------------------------------------
# Public DNS name of the API; an A/AAAA record must point at this VM before first start.
GONARRA_API_HOST=api.example.com
# Contact for the ACME (Let's Encrypt) account; expiry warnings go here.
ACME_EMAIL=owner@example.com
# acme (default, public certificate) | internal (Caddy local CA, smoke tests only).
GONARRA_TLS_MODE=acme
# Database credentials. Generate the password once: openssl rand -base64 32 | tr -d '/+='
POSTGRES_DB=gonarra
POSTGRES_USER=gonarra
POSTGRES_PASSWORD=
# API image name and tag. Deploys set the tag to the git commit; rollback = previous tag.
GONARRA_API_IMAGE=gonarra-api
GONARRA_API_TAG=latest
# Nightly pg_dump at BACKUP_HOUR in BACKUP_TZ, kept BACKUP_RETENTION_DAYS days.
BACKUP_TZ=Asia/Ho_Chi_Minh
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

# --- API (GONARRA_*) -----------------------------------------------------------------------
GONARRA_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
GONARRA_CLERK_AUDIENCE=
GONARRA_CLERK_AUTHORIZED_PARTIES=gonarra://
GONARRA_CURATOR_CLERK_USER_IDS=
GONARRA_CLERK_SECRET_KEY=
# Must stay 0 in production (the API refuses to start otherwise).
GONARRA_DEMO_SHARED_USER=0
GONARRA_MEDIA_BASE_URL=https://api.example.com/media
GONARRA_GEMINI_API_KEY=
GONARRA_GROQ_API_KEY=
GONARRA_TAVILY_API_KEY=
# Required in production: estimate routing is refused outside development/test/demo.
GONARRA_GOOGLE_MAPS_API_KEY=
GONARRA_ROUTES_PROVIDER=google
GONARRA_ROUTES_ESTIMATE_ENABLED=false
GONARRA_RESEARCH_ENABLED=false
GONARRA_STAY_PRICES_ENABLED=false
# Uvicorn worker processes (1 fits a 2 GB t4g.small).
WEB_CONCURRENCY=1
